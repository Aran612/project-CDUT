<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AolProgramMapper">

    <resultMap type="AolProgram" id="AolProgramResult">
        <result property="programId"      column="program_id"      />
        <result property="programName"    column="program_name"    />
        <result property="programNameEn"  column="program_name_en" />
        <result property="degreeLevel"    column="degree_level"    />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectAolProgramVo">
        select program_id, program_name, program_name_en, degree_level, status, create_by, create_time, update_by, update_time, remark
        from aol_program
    </sql>

    <select id="selectAolProgramList" parameterType="AolProgram" resultMap="AolProgramResult">
        <include refid="selectAolProgramVo"/>
        <where>
            <if test="programName != null  and programName != ''"> and program_name like concat('%', #{programName}, '%')</if>
            <if test="programNameEn != null  and programNameEn != ''"> and program_name_en like concat('%', #{programNameEn}, '%')</if>
            <if test="degreeLevel != null  and degreeLevel != ''"> and degree_level = #{degreeLevel}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by program_id asc
    </select>

    <select id="selectAolProgramByProgramId" parameterType="Long" resultMap="AolProgramResult">
        <include refid="selectAolProgramVo"/>
        where program_id = #{programId}
    </select>

    <insert id="insertAolProgram" parameterType="AolProgram" useGeneratedKeys="true" keyProperty="programId">
        insert into aol_program
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="programName != null and programName != ''">program_name,</if>
            <if test="programNameEn != null">program_name_en,</if>
            <if test="degreeLevel != null and degreeLevel != ''">degree_level,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="programName != null and programName != ''">#{programName},</if>
            <if test="programNameEn != null">#{programNameEn},</if>
            <if test="degreeLevel != null and degreeLevel != ''">#{degreeLevel},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAolProgram" parameterType="AolProgram">
        update aol_program
        <trim prefix="SET" suffixOverrides=",">
            <if test="programName != null and programName != ''">program_name = #{programName},</if>
            <if test="programNameEn != null">program_name_en = #{programNameEn},</if>
            <if test="degreeLevel != null and degreeLevel != ''">degree_level = #{degreeLevel},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where program_id = #{programId}
    </update>

    <delete id="deleteAolProgramByProgramId" parameterType="Long">
        delete from aol_program where program_id = #{programId}
    </delete>

    <delete id="deleteAolProgramByProgramIds" parameterType="String">
        delete from aol_program where program_id in
        <foreach item="programId" collection="array" open="(" separator="," close=")">
            #{programId}
        </foreach>
    </delete>

</mapper>
