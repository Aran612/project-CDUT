<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AolCgMapper">

    <resultMap type="AolCg" id="AolCgResult">
        <result property="cgId"           column="cg_id"           />
        <result property="programId"      column="program_id"      />
        <result property="cgCode"         column="cg_code"         />
        <result property="cgName"         column="cg_name"         />
        <result property="cgNameEn"       column="cg_name_en"      />
        <result property="description"    column="description"     />
        <result property="descriptionEn"  column="description_en"  />
        <result property="sortOrder"      column="sort_order"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectAolCgVo">
        select cg_id, program_id, cg_code, cg_name, cg_name_en, description, description_en, sort_order, status, create_by, create_time, update_by, update_time, remark
        from aol_cg
    </sql>

    <select id="selectAolCgList" parameterType="AolCg" resultMap="AolCgResult">
        <include refid="selectAolCgVo"/>
        <where>
            <if test="programId != null"> and program_id = #{programId}</if>
            <if test="cgCode != null  and cgCode != ''"> and cg_code = #{cgCode}</if>
            <if test="cgName != null  and cgName != ''"> and cg_name like concat('%', #{cgName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order asc, cg_id asc
    </select>

    <select id="selectAolCgByCgId" parameterType="Long" resultMap="AolCgResult">
        <include refid="selectAolCgVo"/>
        where cg_id = #{cgId}
    </select>

    <insert id="insertAolCg" parameterType="AolCg" useGeneratedKeys="true" keyProperty="cgId">
        insert into aol_cg
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="programId != null">program_id,</if>
            <if test="cgCode != null and cgCode != ''">cg_code,</if>
            <if test="cgName != null">cg_name,</if>
            <if test="cgNameEn != null">cg_name_en,</if>
            <if test="description != null">description,</if>
            <if test="descriptionEn != null">description_en,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="programId != null">#{programId},</if>
            <if test="cgCode != null and cgCode != ''">#{cgCode},</if>
            <if test="cgName != null">#{cgName},</if>
            <if test="cgNameEn != null">#{cgNameEn},</if>
            <if test="description != null">#{description},</if>
            <if test="descriptionEn != null">#{descriptionEn},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAolCg" parameterType="AolCg">
        update aol_cg
        <trim prefix="SET" suffixOverrides=",">
            <if test="programId != null">program_id = #{programId},</if>
            <if test="cgCode != null and cgCode != ''">cg_code = #{cgCode},</if>
            <if test="cgName != null">cg_name = #{cgName},</if>
            <if test="cgNameEn != null">cg_name_en = #{cgNameEn},</if>
            <if test="description != null">description = #{description},</if>
            <if test="descriptionEn != null">description_en = #{descriptionEn},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where cg_id = #{cgId}
    </update>

    <delete id="deleteAolCgByCgId" parameterType="Long">
        delete from aol_cg where cg_id = #{cgId}
    </delete>

    <delete id="deleteAolCgByCgIds" parameterType="String">
        delete from aol_cg where cg_id in
        <foreach item="cgId" collection="array" open="(" separator="," close=")">
            #{cgId}
        </foreach>
    </delete>

</mapper>
