<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvDevelopmentMapper">

    <resultMap type="MsCvDevelopment" id="MsCvDevelopmentResult">
        <result property="devId"        column="dev_id"        />
        <result property="professorId"  column="professor_id"  />
        <result property="period"       column="period"        />
        <result property="activity"     column="activity"      />
        <result property="organizer"    column="organizer"     />
        <result property="hours"        column="hours"         />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectMsCvDevelopmentVo">
        select dev_id, professor_id, period, activity, organizer, hours, sort_order, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_development
    </sql>

    <select id="selectMsCvDevelopmentList" parameterType="MsCvDevelopment" resultMap="MsCvDevelopmentResult">
        <include refid="selectMsCvDevelopmentVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="period != null  and period != ''"> and period like concat('%', #{period}, '%')</if>
            <if test="activity != null  and activity != ''"> and activity like concat('%', #{activity}, '%')</if>
            <if test="organizer != null  and organizer != ''"> and organizer like concat('%', #{organizer}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order, dev_id
    </select>

    <select id="selectMsCvDevelopmentByDevId" parameterType="Long" resultMap="MsCvDevelopmentResult">
        <include refid="selectMsCvDevelopmentVo"/>
        where dev_id = #{devId}
    </select>

    <insert id="insertMsCvDevelopment" parameterType="MsCvDevelopment" useGeneratedKeys="true" keyProperty="devId">
        insert into ms_cv_development
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="period != null">period,</if>
            <if test="activity != null">activity,</if>
            <if test="organizer != null">organizer,</if>
            <if test="hours != null">hours,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="period != null">#{period},</if>
            <if test="activity != null">#{activity},</if>
            <if test="organizer != null">#{organizer},</if>
            <if test="hours != null">#{hours},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvDevelopment" parameterType="MsCvDevelopment">
        update ms_cv_development
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="period != null">period = #{period},</if>
            <if test="activity != null">activity = #{activity},</if>
            <if test="organizer != null">organizer = #{organizer},</if>
            <if test="hours != null">hours = #{hours},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where dev_id = #{devId}
    </update>

    <delete id="deleteMsCvDevelopmentByDevId" parameterType="Long">
        delete from ms_cv_development where dev_id = #{devId}
    </delete>

    <delete id="deleteMsCvDevelopmentByDevIds" parameterType="String">
        delete from ms_cv_development where dev_id in
        <foreach item="devId" collection="array" open="(" separator="," close=")">
            #{devId}
        </foreach>
    </delete>

</mapper>
