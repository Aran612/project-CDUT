<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvServiceMapper">

    <resultMap type="MsCvService" id="MsCvServiceResult">
        <result property="serviceId"      column="service_id"      />
        <result property="professorId"    column="professor_id"    />
        <result property="period"         column="period"          />
        <result property="serviceContent" column="service_content" />
        <result property="organization"   column="organization"    />
        <result property="sortOrder"      column="sort_order"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectMsCvServiceVo">
        select service_id, professor_id, period, service_content, organization, sort_order, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_service
    </sql>

    <select id="selectMsCvServiceList" parameterType="MsCvService" resultMap="MsCvServiceResult">
        <include refid="selectMsCvServiceVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="period != null  and period != ''"> and period like concat('%', #{period}, '%')</if>
            <if test="serviceContent != null  and serviceContent != ''"> and service_content like concat('%', #{serviceContent}, '%')</if>
            <if test="organization != null  and organization != ''"> and organization like concat('%', #{organization}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order, service_id
    </select>

    <select id="selectMsCvServiceByServiceId" parameterType="Long" resultMap="MsCvServiceResult">
        <include refid="selectMsCvServiceVo"/>
        where service_id = #{serviceId}
    </select>

    <insert id="insertMsCvService" parameterType="MsCvService" useGeneratedKeys="true" keyProperty="serviceId">
        insert into ms_cv_service
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="period != null">period,</if>
            <if test="serviceContent != null">service_content,</if>
            <if test="organization != null">organization,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="period != null">#{period},</if>
            <if test="serviceContent != null">#{serviceContent},</if>
            <if test="organization != null">#{organization},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvService" parameterType="MsCvService">
        update ms_cv_service
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="period != null">period = #{period},</if>
            <if test="serviceContent != null">service_content = #{serviceContent},</if>
            <if test="organization != null">organization = #{organization},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where service_id = #{serviceId}
    </update>

    <delete id="deleteMsCvServiceByServiceId" parameterType="Long">
        delete from ms_cv_service where service_id = #{serviceId}
    </delete>

    <delete id="deleteMsCvServiceByServiceIds" parameterType="String">
        delete from ms_cv_service where service_id in
        <foreach item="serviceId" collection="array" open="(" separator="," close=")">
            #{serviceId}
        </foreach>
    </delete>

</mapper>
