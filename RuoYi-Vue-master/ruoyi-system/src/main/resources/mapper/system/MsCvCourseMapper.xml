<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvCourseMapper">

    <resultMap type="MsCvCourse" id="MsCvCourseResult">
        <result property="cvCourseId"   column="cv_course_id"  />
        <result property="professorId"  column="professor_id"  />
        <result property="courseName"   column="course_name"   />
        <result property="levelName"    column="level_name"    />
        <result property="academicYear" column="academic_year" />
        <result property="teachRole"    column="teach_role"    />
        <result property="weeklyHours"  column="weekly_hours"  />
        <result property="source"       column="source"        />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectMsCvCourseVo">
        select cv_course_id, professor_id, course_name, level_name, academic_year, teach_role, weekly_hours, source, sort_order, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_course
    </sql>

    <select id="selectMsCvCourseList" parameterType="MsCvCourse" resultMap="MsCvCourseResult">
        <include refid="selectMsCvCourseVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="courseName != null  and courseName != ''"> and course_name like concat('%', #{courseName}, '%')</if>
            <if test="levelName != null  and levelName != ''"> and level_name = #{levelName}</if>
            <if test="academicYear != null  and academicYear != ''"> and academic_year = #{academicYear}</if>
            <if test="teachRole != null  and teachRole != ''"> and teach_role = #{teachRole}</if>
            <if test="source != null  and source != ''"> and source = #{source}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order, cv_course_id
    </select>

    <select id="selectMsCvCourseByCvCourseId" parameterType="Long" resultMap="MsCvCourseResult">
        <include refid="selectMsCvCourseVo"/>
        where cv_course_id = #{cvCourseId}
    </select>

    <insert id="insertMsCvCourse" parameterType="MsCvCourse" useGeneratedKeys="true" keyProperty="cvCourseId">
        insert into ms_cv_course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="courseName != null">course_name,</if>
            <if test="levelName != null">level_name,</if>
            <if test="academicYear != null">academic_year,</if>
            <if test="teachRole != null and teachRole != ''">teach_role,</if>
            <if test="weeklyHours != null">weekly_hours,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="courseName != null">#{courseName},</if>
            <if test="levelName != null">#{levelName},</if>
            <if test="academicYear != null">#{academicYear},</if>
            <if test="teachRole != null and teachRole != ''">#{teachRole},</if>
            <if test="weeklyHours != null">#{weeklyHours},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvCourse" parameterType="MsCvCourse">
        update ms_cv_course
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="courseName != null">course_name = #{courseName},</if>
            <if test="levelName != null">level_name = #{levelName},</if>
            <if test="academicYear != null">academic_year = #{academicYear},</if>
            <if test="teachRole != null and teachRole != ''">teach_role = #{teachRole},</if>
            <if test="weeklyHours != null">weekly_hours = #{weeklyHours},</if>
            <if test="source != null and source != ''">source = #{source},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where cv_course_id = #{cvCourseId}
    </update>

    <delete id="deleteMsCvCourseByCvCourseId" parameterType="Long">
        delete from ms_cv_course where cv_course_id = #{cvCourseId}
    </delete>

    <delete id="deleteMsCvCourseByCvCourseIds" parameterType="String">
        delete from ms_cv_course where cv_course_id in
        <foreach item="cvCourseId" collection="array" open="(" separator="," close=")">
            #{cvCourseId}
        </foreach>
    </delete>

</mapper>
