<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AolMapCourseMapper">

    <resultMap type="AolMapCourse" id="AolMapCourseResult">
        <result property="mapCourseId"    column="map_course_id"   />
        <result property="programId"      column="program_id"      />
        <result property="courseId"       column="course_id"       />
        <result property="courseName"     column="course_name"     />
        <result property="courseNameEn"   column="course_name_en"  />
        <result property="yearLevel"      column="year_level"      />
        <result property="courseKind"     column="course_kind"     />
        <result property="primaryLgs"     column="primary_lgs"     />
        <result property="sortOrder"      column="sort_order"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectAolMapCourseVo">
        select map_course_id, program_id, course_id, course_name, course_name_en, year_level, course_kind, primary_lgs, sort_order, status, create_by, create_time, update_by, update_time, remark
        from aol_map_course
    </sql>

    <select id="selectAolMapCourseList" parameterType="AolMapCourse" resultMap="AolMapCourseResult">
        <include refid="selectAolMapCourseVo"/>
        <where>
            <if test="programId != null"> and program_id = #{programId}</if>
            <if test="courseId != null"> and course_id = #{courseId}</if>
            <if test="courseName != null  and courseName != ''"> and course_name like concat('%', #{courseName}, '%')</if>
            <if test="courseNameEn != null  and courseNameEn != ''"> and course_name_en like concat('%', #{courseNameEn}, '%')</if>
            <if test="yearLevel != null  and yearLevel != ''"> and year_level = #{yearLevel}</if>
            <if test="courseKind != null  and courseKind != ''"> and course_kind = #{courseKind}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order asc, map_course_id asc
    </select>

    <select id="selectAolMapCourseByMapCourseId" parameterType="Long" resultMap="AolMapCourseResult">
        <include refid="selectAolMapCourseVo"/>
        where map_course_id = #{mapCourseId}
    </select>

    <insert id="insertAolMapCourse" parameterType="AolMapCourse" useGeneratedKeys="true" keyProperty="mapCourseId">
        insert into aol_map_course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="programId != null">program_id,</if>
            <if test="courseId != null">course_id,</if>
            <if test="courseName != null">course_name,</if>
            <if test="courseNameEn != null">course_name_en,</if>
            <if test="yearLevel != null">year_level,</if>
            <if test="courseKind != null">course_kind,</if>
            <if test="primaryLgs != null">primary_lgs,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="programId != null">#{programId},</if>
            <if test="courseId != null">#{courseId},</if>
            <if test="courseName != null">#{courseName},</if>
            <if test="courseNameEn != null">#{courseNameEn},</if>
            <if test="yearLevel != null">#{yearLevel},</if>
            <if test="courseKind != null">#{courseKind},</if>
            <if test="primaryLgs != null">#{primaryLgs},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAolMapCourse" parameterType="AolMapCourse">
        update aol_map_course
        <trim prefix="SET" suffixOverrides=",">
            <if test="programId != null">program_id = #{programId},</if>
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="courseName != null">course_name = #{courseName},</if>
            <if test="courseNameEn != null">course_name_en = #{courseNameEn},</if>
            <if test="yearLevel != null">year_level = #{yearLevel},</if>
            <if test="courseKind != null">course_kind = #{courseKind},</if>
            <if test="primaryLgs != null">primary_lgs = #{primaryLgs},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where map_course_id = #{mapCourseId}
    </update>

    <delete id="deleteAolMapCourseByMapCourseId" parameterType="Long">
        delete from aol_map_course where map_course_id = #{mapCourseId}
    </delete>

    <delete id="deleteAolMapCourseByMapCourseIds" parameterType="String">
        delete from aol_map_course where map_course_id in
        <foreach item="mapCourseId" collection="array" open="(" separator="," close=")">
            #{mapCourseId}
        </foreach>
    </delete>

</mapper>
