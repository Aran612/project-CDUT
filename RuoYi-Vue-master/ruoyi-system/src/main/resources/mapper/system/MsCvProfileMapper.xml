<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvProfileMapper">

    <resultMap type="MsCvProfile" id="MsCvProfileResult">
        <result property="cvId"             column="cv_id"             />
        <result property="professorId"      column="professor_id"      />
        <result property="cdutId"           column="cdut_id"           />
        <result property="photoUrl"         column="photo_url"         />
        <result property="phone"            column="phone"             />
        <result property="position"         column="position"          />
        <result property="employmentType"   column="employment_type"   />
        <result property="aacsbClass"       column="aacsb_class"       />
        <result property="employer"         column="employer"          />
        <result property="address"          column="address"           />
        <result property="areasOfInterest"  column="areas_of_interest" />
        <result property="otherInfo"        column="other_info"        />
        <result property="declareFlag"      column="declare_flag"      />
        <result property="declareTime"      column="declare_time"      />
        <result property="status"           column="status"            />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectMsCvProfileVo">
        select cv_id, professor_id, cdut_id, photo_url, phone, position, employment_type, aacsb_class, employer, address, areas_of_interest, other_info, declare_flag, declare_time, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_profile
    </sql>

    <select id="selectMsCvProfileList" parameterType="MsCvProfile" resultMap="MsCvProfileResult">
        <include refid="selectMsCvProfileVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="cdutId != null  and cdutId != ''"> and cdut_id = #{cdutId}</if>
            <if test="phone != null  and phone != ''"> and phone like concat('%', #{phone}, '%')</if>
            <if test="position != null  and position != ''"> and position like concat('%', #{position}, '%')</if>
            <if test="employmentType != null  and employmentType != ''"> and employment_type = #{employmentType}</if>
            <if test="aacsbClass != null  and aacsbClass != ''"> and aacsb_class = #{aacsbClass}</if>
            <if test="employer != null  and employer != ''"> and employer like concat('%', #{employer}, '%')</if>
            <if test="declareFlag != null  and declareFlag != ''"> and declare_flag = #{declareFlag}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by cv_id desc
    </select>

    <select id="selectMsCvProfileByCvId" parameterType="Long" resultMap="MsCvProfileResult">
        <include refid="selectMsCvProfileVo"/>
        where cv_id = #{cvId}
    </select>

    <select id="selectMsCvProfileByProfessorId" parameterType="Long" resultMap="MsCvProfileResult">
        <include refid="selectMsCvProfileVo"/>
        where professor_id = #{professorId}
    </select>

    <!-- 按登录用户ID查找教师ID（CV本人身份解析） -->
    <select id="selectProfessorIdByUserId" parameterType="Long" resultType="Long">
        select professor_id from ms_professor where user_id = #{userId} and status = '0' limit 1
    </select>

    <insert id="insertMsCvProfile" parameterType="MsCvProfile" useGeneratedKeys="true" keyProperty="cvId">
        insert into ms_cv_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="cdutId != null">cdut_id,</if>
            <if test="photoUrl != null">photo_url,</if>
            <if test="phone != null">phone,</if>
            <if test="position != null">position,</if>
            <if test="employmentType != null and employmentType != ''">employment_type,</if>
            <if test="aacsbClass != null">aacsb_class,</if>
            <if test="employer != null">employer,</if>
            <if test="address != null">address,</if>
            <if test="areasOfInterest != null">areas_of_interest,</if>
            <if test="otherInfo != null">other_info,</if>
            <if test="declareFlag != null and declareFlag != ''">declare_flag,</if>
            <if test="declareTime != null">declare_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="cdutId != null">#{cdutId},</if>
            <if test="photoUrl != null">#{photoUrl},</if>
            <if test="phone != null">#{phone},</if>
            <if test="position != null">#{position},</if>
            <if test="employmentType != null and employmentType != ''">#{employmentType},</if>
            <if test="aacsbClass != null">#{aacsbClass},</if>
            <if test="employer != null">#{employer},</if>
            <if test="address != null">#{address},</if>
            <if test="areasOfInterest != null">#{areasOfInterest},</if>
            <if test="otherInfo != null">#{otherInfo},</if>
            <if test="declareFlag != null and declareFlag != ''">#{declareFlag},</if>
            <if test="declareTime != null">#{declareTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvProfile" parameterType="MsCvProfile">
        update ms_cv_profile
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="cdutId != null">cdut_id = #{cdutId},</if>
            <if test="photoUrl != null">photo_url = #{photoUrl},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="position != null">position = #{position},</if>
            <if test="employmentType != null and employmentType != ''">employment_type = #{employmentType},</if>
            <if test="aacsbClass != null">aacsb_class = #{aacsbClass},</if>
            <if test="employer != null">employer = #{employer},</if>
            <if test="address != null">address = #{address},</if>
            <if test="areasOfInterest != null">areas_of_interest = #{areasOfInterest},</if>
            <if test="otherInfo != null">other_info = #{otherInfo},</if>
            <if test="declareFlag != null and declareFlag != ''">declare_flag = #{declareFlag},</if>
            <if test="declareTime != null">declare_time = #{declareTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where cv_id = #{cvId}
    </update>

    <delete id="deleteMsCvProfileByCvId" parameterType="Long">
        delete from ms_cv_profile where cv_id = #{cvId}
    </delete>

    <delete id="deleteMsCvProfileByCvIds" parameterType="String">
        delete from ms_cv_profile where cv_id in
        <foreach item="cvId" collection="array" open="(" separator="," close=")">
            #{cvId}
        </foreach>
    </delete>

</mapper>
