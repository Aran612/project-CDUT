<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AolAssessmentMapper">

    <resultMap type="AolAssessment" id="AolAssessmentResult">
        <result property="assessId"         column="assess_id"         />
        <result property="programId"        column="program_id"        />
        <result property="cgId"             column="cg_id"             />
        <result property="lgsAssessed"      column="lgs_assessed"      />
        <result property="directMeasures"   column="direct_measures"   />
        <result property="rubricThreshold"  column="rubric_threshold"  />
        <result property="indirectMeasures" column="indirect_measures" />
        <result property="frequency"        column="frequency"         />
        <result property="sortOrder"        column="sort_order"        />
        <result property="status"           column="status"            />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectAolAssessmentVo">
        select assess_id, program_id, cg_id, lgs_assessed, direct_measures, rubric_threshold, indirect_measures, frequency, sort_order, status, create_by, create_time, update_by, update_time, remark
        from aol_assessment
    </sql>

    <select id="selectAolAssessmentList" parameterType="AolAssessment" resultMap="AolAssessmentResult">
        <include refid="selectAolAssessmentVo"/>
        <where>
            <if test="programId != null"> and program_id = #{programId}</if>
            <if test="cgId != null"> and cg_id = #{cgId}</if>
            <if test="frequency != null  and frequency != ''"> and frequency = #{frequency}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order asc, assess_id asc
    </select>

    <select id="selectAolAssessmentByAssessId" parameterType="Long" resultMap="AolAssessmentResult">
        <include refid="selectAolAssessmentVo"/>
        where assess_id = #{assessId}
    </select>

    <insert id="insertAolAssessment" parameterType="AolAssessment" useGeneratedKeys="true" keyProperty="assessId">
        insert into aol_assessment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="programId != null">program_id,</if>
            <if test="cgId != null">cg_id,</if>
            <if test="lgsAssessed != null">lgs_assessed,</if>
            <if test="directMeasures != null">direct_measures,</if>
            <if test="rubricThreshold != null">rubric_threshold,</if>
            <if test="indirectMeasures != null">indirect_measures,</if>
            <if test="frequency != null">frequency,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="programId != null">#{programId},</if>
            <if test="cgId != null">#{cgId},</if>
            <if test="lgsAssessed != null">#{lgsAssessed},</if>
            <if test="directMeasures != null">#{directMeasures},</if>
            <if test="rubricThreshold != null">#{rubricThreshold},</if>
            <if test="indirectMeasures != null">#{indirectMeasures},</if>
            <if test="frequency != null">#{frequency},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAolAssessment" parameterType="AolAssessment">
        update aol_assessment
        <trim prefix="SET" suffixOverrides=",">
            <if test="programId != null">program_id = #{programId},</if>
            <if test="cgId != null">cg_id = #{cgId},</if>
            <if test="lgsAssessed != null">lgs_assessed = #{lgsAssessed},</if>
            <if test="directMeasures != null">direct_measures = #{directMeasures},</if>
            <if test="rubricThreshold != null">rubric_threshold = #{rubricThreshold},</if>
            <if test="indirectMeasures != null">indirect_measures = #{indirectMeasures},</if>
            <if test="frequency != null">frequency = #{frequency},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where assess_id = #{assessId}
    </update>

    <delete id="deleteAolAssessmentByAssessId" parameterType="Long">
        delete from aol_assessment where assess_id = #{assessId}
    </delete>

    <delete id="deleteAolAssessmentByAssessIds" parameterType="String">
        delete from aol_assessment where assess_id in
        <foreach item="assessId" collection="array" open="(" separator="," close=")">
            #{assessId}
        </foreach>
    </delete>

</mapper>
