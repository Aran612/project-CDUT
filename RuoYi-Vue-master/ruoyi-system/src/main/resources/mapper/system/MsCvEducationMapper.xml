<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvEducationMapper">

    <resultMap type="MsCvEducation" id="MsCvEducationResult">
        <result property="educationId"  column="education_id"  />
        <result property="professorId"  column="professor_id"  />
        <result property="degree"       column="degree"        />
        <result property="major"        column="major"         />
        <result property="institution"  column="institution"   />
        <result property="gradYear"     column="grad_year"     />
        <result property="isHighest"    column="is_highest"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectMsCvEducationVo">
        select education_id, professor_id, degree, major, institution, grad_year, is_highest, sort_order, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_education
    </sql>

    <select id="selectMsCvEducationList" parameterType="MsCvEducation" resultMap="MsCvEducationResult">
        <include refid="selectMsCvEducationVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="degree != null  and degree != ''"> and degree like concat('%', #{degree}, '%')</if>
            <if test="major != null  and major != ''"> and major like concat('%', #{major}, '%')</if>
            <if test="institution != null  and institution != ''"> and institution like concat('%', #{institution}, '%')</if>
            <if test="gradYear != null  and gradYear != ''"> and grad_year = #{gradYear}</if>
            <if test="isHighest != null  and isHighest != ''"> and is_highest = #{isHighest}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order, education_id
    </select>

    <select id="selectMsCvEducationByEducationId" parameterType="Long" resultMap="MsCvEducationResult">
        <include refid="selectMsCvEducationVo"/>
        where education_id = #{educationId}
    </select>

    <insert id="insertMsCvEducation" parameterType="MsCvEducation" useGeneratedKeys="true" keyProperty="educationId">
        insert into ms_cv_education
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="degree != null">degree,</if>
            <if test="major != null">major,</if>
            <if test="institution != null">institution,</if>
            <if test="gradYear != null">grad_year,</if>
            <if test="isHighest != null and isHighest != ''">is_highest,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="degree != null">#{degree},</if>
            <if test="major != null">#{major},</if>
            <if test="institution != null">#{institution},</if>
            <if test="gradYear != null">#{gradYear},</if>
            <if test="isHighest != null and isHighest != ''">#{isHighest},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvEducation" parameterType="MsCvEducation">
        update ms_cv_education
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="degree != null">degree = #{degree},</if>
            <if test="major != null">major = #{major},</if>
            <if test="institution != null">institution = #{institution},</if>
            <if test="gradYear != null">grad_year = #{gradYear},</if>
            <if test="isHighest != null and isHighest != ''">is_highest = #{isHighest},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where education_id = #{educationId}
    </update>

    <delete id="deleteMsCvEducationByEducationId" parameterType="Long">
        delete from ms_cv_education where education_id = #{educationId}
    </delete>

    <delete id="deleteMsCvEducationByEducationIds" parameterType="String">
        delete from ms_cv_education where education_id in
        <foreach item="educationId" collection="array" open="(" separator="," close=")">
            #{educationId}
        </foreach>
    </delete>

</mapper>
