<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsCvCertificationMapper">

    <resultMap type="MsCvCertification" id="MsCvCertificationResult">
        <result property="certId"       column="cert_id"       />
        <result property="professorId"  column="professor_id"  />
        <result property="certName"     column="cert_name"     />
        <result property="issuingBody"  column="issuing_body"  />
        <result property="certYear"     column="cert_year"     />
        <result property="statusText"   column="status_text"   />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectMsCvCertificationVo">
        select cert_id, professor_id, cert_name, issuing_body, cert_year, status_text, sort_order, status, create_by, create_time, update_by, update_time, remark
        from ms_cv_certification
    </sql>

    <select id="selectMsCvCertificationList" parameterType="MsCvCertification" resultMap="MsCvCertificationResult">
        <include refid="selectMsCvCertificationVo"/>
        <where>
            <if test="professorId != null "> and professor_id = #{professorId}</if>
            <if test="certName != null  and certName != ''"> and cert_name like concat('%', #{certName}, '%')</if>
            <if test="issuingBody != null  and issuingBody != ''"> and issuing_body like concat('%', #{issuingBody}, '%')</if>
            <if test="certYear != null  and certYear != ''"> and cert_year = #{certYear}</if>
            <if test="statusText != null  and statusText != ''"> and status_text = #{statusText}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order, cert_id
    </select>

    <select id="selectMsCvCertificationByCertId" parameterType="Long" resultMap="MsCvCertificationResult">
        <include refid="selectMsCvCertificationVo"/>
        where cert_id = #{certId}
    </select>

    <insert id="insertMsCvCertification" parameterType="MsCvCertification" useGeneratedKeys="true" keyProperty="certId">
        insert into ms_cv_certification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="professorId != null">professor_id,</if>
            <if test="certName != null">cert_name,</if>
            <if test="issuingBody != null">issuing_body,</if>
            <if test="certYear != null">cert_year,</if>
            <if test="statusText != null">status_text,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="professorId != null">#{professorId},</if>
            <if test="certName != null">#{certName},</if>
            <if test="issuingBody != null">#{issuingBody},</if>
            <if test="certYear != null">#{certYear},</if>
            <if test="statusText != null">#{statusText},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsCvCertification" parameterType="MsCvCertification">
        update ms_cv_certification
        <trim prefix="SET" suffixOverrides=",">
            <if test="professorId != null">professor_id = #{professorId},</if>
            <if test="certName != null">cert_name = #{certName},</if>
            <if test="issuingBody != null">issuing_body = #{issuingBody},</if>
            <if test="certYear != null">cert_year = #{certYear},</if>
            <if test="statusText != null">status_text = #{statusText},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where cert_id = #{certId}
    </update>

    <delete id="deleteMsCvCertificationByCertId" parameterType="Long">
        delete from ms_cv_certification where cert_id = #{certId}
    </delete>

    <delete id="deleteMsCvCertificationByCertIds" parameterType="String">
        delete from ms_cv_certification where cert_id in
        <foreach item="certId" collection="array" open="(" separator="," close=")">
            #{certId}
        </foreach>
    </delete>

</mapper>
