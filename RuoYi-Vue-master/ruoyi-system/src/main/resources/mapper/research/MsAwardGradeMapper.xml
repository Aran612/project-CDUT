<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsAwardGradeMapper">
    <resultMap type="MsAwardGrade" id="MsAwardGradeResult">
        <result property="gradeId" column="grade_id"/>
        <result property="gradeCode" column="grade_code"/>
        <result property="gradeName" column="grade_name"/>
        <result property="baseScore" column="base_score"/>
        <result property="awardCategory" column="award_category"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="vo">select grade_id, grade_code, grade_name, base_score, award_category, sort_order, status, create_by, create_time, update_by, update_time, remark from ms_award_grade</sql>
    <select id="selectMsAwardGradeByGradeId" parameterType="Long" resultMap="MsAwardGradeResult"><include refid="vo"/> where grade_id = #{gradeId}</select>
    <select id="selectMsAwardGradeByGradeName" parameterType="String" resultMap="MsAwardGradeResult"><include refid="vo"/> where grade_name = #{gradeName} limit 1</select>
    <select id="selectMsAwardGradeAll" resultMap="MsAwardGradeResult"><include refid="vo"/> where status = '0' order by sort_order asc</select>
</mapper>
