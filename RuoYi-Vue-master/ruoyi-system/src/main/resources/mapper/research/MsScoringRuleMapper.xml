<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsScoringRuleMapper">

    <resultMap type="MsScoringRule" id="MsScoringRuleResult">
        <result property="ruleId"        column="rule_id"         />
        <result property="gradeId"       column="grade_id"        />
        <result property="positionType"  column="position_type"   />
        <result property="coefficient"   column="coefficient"     />
        <result property="status"        column="status"          />
        <result property="createBy"      column="create_by"       />
        <result property="createTime"    column="create_time"     />
        <result property="updateBy"      column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"          />
    </resultMap>

    <sql id="selectMsScoringRuleVo">
        select rule_id, grade_id, position_type, coefficient, status, create_by, create_time, update_by, update_time, remark
        from ms_scoring_rule
    </sql>

    <select id="selectMsScoringRuleList" parameterType="MsScoringRule" resultMap="MsScoringRuleResult">
        <include refid="selectMsScoringRuleVo"/>
        <where>
            <if test="gradeId != null"> and grade_id = #{gradeId}</if>
            <if test="positionType != null  and positionType != ''"> and position_type = #{positionType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by grade_id asc
    </select>

    <select id="selectMsScoringRuleByRuleId" parameterType="Long" resultMap="MsScoringRuleResult">
        <include refid="selectMsScoringRuleVo"/>
        where rule_id = #{ruleId}
    </select>

    <select id="selectMsScoringRuleByGradeIdAndPosition" resultMap="MsScoringRuleResult">
        <include refid="selectMsScoringRuleVo"/>
        where grade_id = #{gradeId} and position_type = #{positionType} and status = '0'
    </select>

    <insert id="insertMsScoringRule" parameterType="MsScoringRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into ms_scoring_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gradeId != null">grade_id,</if>
            <if test="positionType != null and positionType != ''">position_type,</if>
            <if test="coefficient != null">coefficient,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gradeId != null">#{gradeId},</if>
            <if test="positionType != null and positionType != ''">#{positionType},</if>
            <if test="coefficient != null">#{coefficient},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsScoringRule" parameterType="MsScoringRule">
        update ms_scoring_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="gradeId != null">grade_id = #{gradeId},</if>
            <if test="positionType != null and positionType != ''">position_type = #{positionType},</if>
            <if test="coefficient != null">coefficient = #{coefficient},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteMsScoringRuleByRuleId" parameterType="Long">
        delete from ms_scoring_rule where rule_id = #{ruleId}
    </delete>

    <delete id="deleteMsScoringRuleByRuleIds" parameterType="String">
        delete from ms_scoring_rule where rule_id in
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

</mapper>
